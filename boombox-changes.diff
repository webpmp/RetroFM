+function simulateSeek(currentPos: number, duration: number, direction: 'rewind' | 'forward'): number {
+  if (direction === 'rewind') {
+    return Math.max(0, currentPos - 10);
+  } else {
+    return Math.min(duration, currentPos + 10);
+  }
+}
