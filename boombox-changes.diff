+
+function applyRadioState(state) {
+  if (!state || typeof state !== 'object') return;
+  appConnected = state.appConnected !== false;
+
+  if (!appConnected) {
+    $('st').textContent = '■ DISCONNECTED';
+    $('gi').textContent = 'Open RetroFM app to broadcast';
+    song = null;
