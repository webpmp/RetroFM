# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_TEXT_MODEL: Primary text model for DJ Break Generator (default: gemini-3.8-flash)
GEMINI_TEXT_MODEL="gemini-3.8-flash"

# GEMINI_TEXT_MODEL_FALLBACK: Fallback text model if primary model is unavailable after retries (optional)
GEMINI_TEXT_MODEL_FALLBACK="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# YOUTUBE_API_KEY: Required for YouTube Data API v3 search and duration queries.
# Get a key from Google Cloud Console (YouTube Data API v3 enabled).
YOUTUBE_API_KEY="YOUR_YOUTUBE_API_KEY"

# News Providers for Historical Fact Packet Test:
# NEWSAPI_KEY: Required for NewsAPI.org historical/recent queries
NEWSAPI_KEY="YOUR_NEWSAPI_KEY"

# NEWSDATA_API_KEY: Required for NewsData.io news queries
NEWSDATA_API_KEY="YOUR_NEWSDATA_API_KEY"

# NYT_API_KEY: Required for New York Times Archive API (monthly endpoints)
NYT_API_KEY="YOUR_NYT_API_KEY"
