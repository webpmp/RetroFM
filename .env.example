# ==============================================================================
# RetroFM Environment Configuration
# ==============================================================================
# Copy this file to .env and configure the values for your environment:
#   cp .env.example .env
#
# Specific instructions:
# - Required variables are essential for core radio playback and DJ speech.
# - Optional variables provide alternative AI/TTS engines, fallback models, and custom ports.
# - Docker-only variables configure internal ports and container filesystem polling.
# ==============================================================================

# ==============================================================================
# Required
# ==============================================================================

# Get a Gemini API key at: https://aistudio.google.com/app/apikey
# What breaks if missing: DJ voice commentary generation, Gemini TTS speech synthesis, and AI news script writing are disabled.
GEMINI_API_KEY=""

# Get a YouTube Data API v3 key at: https://console.cloud.google.com/apis/credentials (enable YouTube Data API v3)
# What breaks if missing: YouTube music search, video ID resolution, and duration metadata queries fail.
YOUTUBE_API_KEY=""

# ==============================================================================
# Optional
# ==============================================================================

# Base URL where the RetroFM application is accessed.
# Used for YouTube API request Referer headers, self-referential links, and OAuth callbacks.
# When unset, blank, or when its port does not match the running PORT, the app automatically derives http://localhost:<PORT>.
# Where to get: Defaults to http://localhost:3000 locally (or http://localhost:3003 with Docker).
# What breaks if missing: Nothing; automatically falls back to http://localhost:<PORT>.
# APP_URL=http://localhost:3000

# Local HTTP server port (defaults to 3000).
# Where to get: Any open TCP port on your host (e.g. 3000, 3003, 8080).
# What breaks if missing: Nothing; defaults to port 3000.
# PORT=3000

# Get a New York Times Archive API key at: https://developer.nytimes.com/
# What breaks if missing: Historical news facts from NYT Archive are omitted; DJ breaks use plain hand-offs or chart facts without news trivia.
# NYT_API_KEY=your_nyt_api_key_here

# OpenAI-compatible API base URL for local LLMs via LM Studio.
# Docker users: Use http://host.docker.internal:1234/v1 to route container traffic to LM Studio on the host.
# Where to get: Install LM Studio from https://lmstudio.ai/ and start the local Developer Server.
# What breaks if missing: Nothing; the app uses Gemini for script writing unless LM Studio is chosen.
# LM_STUDIO_ENDPOINT=http://localhost:1234/v1

# Specific model identifier to load or query in LM Studio.
# Where to get: Found in LM Studio model selector (e.g. "qwen2.5-7b-instruct"). Leave blank or unset for auto-discovery.
# What breaks if missing: Nothing; LM Studio automatically uses the currently loaded model.
# LM_STUDIO_MODEL=

# Primary Google Gemini model for DJ commentary break generation.
# Default in code: "gemini-3.8-flash" (src/services/djBreak/djBreakService.ts, scriptWriterFactory.ts).
# Verified: gemini-3.8-flash is the primary Gemini 3 Flash multimodal reasoning model in Google DeepMind's Gemini API.
# Where to get: Google Gemini documentation (default: gemini-3.8-flash).
# What breaks if missing: Nothing; code automatically defaults to gemini-3.8-flash.
# GEMINI_TEXT_MODEL=gemini-3.8-flash

# Fallback Gemini text model if the primary model encounters rate limits or errors.
# Default in code: undefined (no fallback model unless configured; falls back within primary model retry loop).
# Where to get: Google Gemini documentation (e.g. gemini-2.5-flash).
# What breaks if missing: Nothing; retries the primary model instead of falling back to a secondary model.
# GEMINI_TEXT_MODEL_FALLBACK=gemini-2.5-flash

# Base URL for Kokoro 82M Fast TTS local HTTP microservice.
# Where to get: Run the Kokoro FastAPI / Docker container locally (default: http://127.0.0.1:8880).
# What breaks if missing: Kokoro local TTS option is unavailable; app defaults to Gemini TTS or browser speech.
# KOKORO_BASE_URL=http://127.0.0.1:8880

# Custom HTTP Referer header sent with YouTube Data API requests.
# Where to get: Match any HTTP Referer restriction configured on your Google Cloud YouTube API key.
# What breaks if missing: Nothing; defaults to APP_URL or http://localhost:<PORT>/.
# YOUTUBE_REFERER=

# SQLite database file path used by offline builder scripts (scripts/export-library-data.ts).
# Where to get: Local path to library.sqlite (defaults to ~/retrofm/library.sqlite).
# What breaks if missing: Nothing at runtime; builder scripts look in ~/retrofm/library.sqlite.
# SQLITE_PATH=

# ==============================================================================
# Docker-only
# ==============================================================================
# Note for Docker users:
# When running with Docker Compose (docker compose up), these settings are already
# provided via docker-compose.yml. If you run custom container commands or override
# docker-compose settings, uncomment the variables below.

# Browser-facing port for Vite Hot Module Replacement (HMR) WebSocket connections.
# Set to 3003 in docker-compose.yml because host port 3003 is mapped to container port 3000.
# What breaks if uncommented on plain "npm run dev": Browser attempts HMR WebSocket connections to non-existent port 3003, causing infinite reconnection/reloads.
# HMR_CLIENT_PORT=3003

# Enables filesystem polling for Vite in containerized bind mounts where inotify is unavailable.
# What breaks if missing in Docker: Vite will not detect file edits made on macOS/Windows host mounted into Linux container.
# WATCH_POLL=true

# Disables Vite HMR WebSocket server entirely (useful for headless CI/CD or cloud sandboxes).
# What breaks if missing: Nothing; HMR runs normally.
# DISABLE_HMR=true
