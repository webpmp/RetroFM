{
  "manifest_version": 3,
  "name": "Retro FM YouTube Bridge",
  "version": "1.0.4",
  "description": "Permitted browser bridge for Retro FM Proof of Concept to detect, group, and control YouTube music playback and audio ducking.",
  "key": "",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "*://localhost/*",
      "*://127.0.0.1/*",
      "*://*.run.app/*",
      "https://*.google.com/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content_youtube.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_retrofm.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Retro FM YouTube Bridge"
  }
}
